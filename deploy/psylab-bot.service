[Unit]
Description=PsyLab Telegram bot (workbook L1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=psylab
Group=psylab
WorkingDirectory=/opt/psylab-bot
EnvironmentFile=/opt/psylab-bot/.env
ExecStart=/opt/psylab-bot/venv/bin/python bot/main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
