{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "app.pluginnavigator.full",
  "applicationName": "Plugin Navigator",
  "version": "2.4.12",
  "description": "Автономный справочник и конструктор цепочек аудиоплагинов",
  "defaultMode": "window",
  "port": 49491,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": false,
  "tokenSecurity": "one-time",
  "singlePageServe": false,
  "dataLocation": "system",
  "storageLocation": "system",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "modes": {
    "window": {
      "title": "Plugin Navigator",
      "width": 1440,
      "height": 900,
      "minWidth": 960,
      "minHeight": 640,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true,
      "useSavedState": true,
      "newWindowPolicy": "browser"
    }
  },
  "cli": {
    "binaryName": "Plugin_Navigator_Full",
    "resourcesPath": "/resources/",
    "resourcesExclude": ".*\\.map$",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0"
  }
}
